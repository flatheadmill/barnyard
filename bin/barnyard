{
    echo '$ export DEBIAN_FRONTEND=noninteractive'
    export DEBIAN_FRONTEND=noninteractive
    echo '$ apt-get update && apt-get install -y zsh gnupg2 git age rsync jo jq'
    apt-get update && apt-get install -y zsh gnupg2 git age rsync jo jq
    echo '$ mkdir -p /var/lib/barnyard'
    mkdir -p /var/lib/barnyard
    echo '$ rm -rf /var/lib/barnyard/zshctl'
    rm -rf /var/lib/barnyard/zshctl
    echo '$ git -C /var/lib/barnyard clone --branch topic/main/redux https://github.com/flatheadmill/zshctl.git'
    git -C /var/lib/barnyard clone --branch topic/main/redux https://github.com/flatheadmill/zshctl.git
    echo '$ rsync -av --delete /var/lib/barnyard/zshctl/share/zshctl/ /usr/share/zshctl/'
    rsync -av --delete /var/lib/barnyard/zshctl/share/zshctl/ /usr/share/zshctl/
    echo '$ install -m 755 /var/lib/barnyard/zshctl/bin/zshctl /usr/bin/'
    install -m 755 /var/lib/barnyard/zshctl/bin/zshctl /usr/bin/
    echo '$ zshctl version'
    zshctl version
    echo '$ echo "$BARNYARD_SOURCE" > /usr/local/bin/barnyard'
    echo "$BARNYARD_SOURCE" > /usr/local/bin/barnyard
    echo '$ chmod 755 /usr/local/bin/barnyard'
    chmod 755 /usr/local/bin/barnyard
    echo '$ barnyard version'
    barnyard version
} 2>&1 | sed -u 's/^/    /'
echo
barnyard agent prepare ubuntu

# TODO Cannot remember all that I wanted to do with property names, but it seems
# like all I need are the directives and based64 encoding. Maybe include is
# something like `@/modules/postgresql/common`.
export BARNYARD_PATH=${${0:a}%/*}

BARNYARD_VERSION=0.26.0
BARNYARD_RELEASE_DATE='January 1, 1970'

function :help {
    heredoc -v help -q <<'    EOF'
        # desc
        Manage foundational machines outside the orchestrator.
        # opt help
        Display help for \`barnyard\`.
        # man
        ## DESCRIPTION
        \`barnyard\` is configuration management for the machines that live
        outside Kubernetes: the foundational virtual machines and services the
        orchestrator deliberately does not cover.

        Barnyard is one executable. A prepared machine receives the single
        \`barnyard\` file at \`/usr/local/bin/barnyard\`; there is no package to
        unpack and no client/server version dance. The file you built is the
        file the machine runs.

        Barnyard reserves exactly five top-level words: \`control\`, \`agent\`,
        \`version\`, \`extend\`, and \`completions\`. Every other Unicode word
        belongs to the user's operators. If Barnyard needs more of its own
        vocabulary, it nests that work under a word it already owns instead of
        taking a sixth.

        ## OPTIONS
        > options
        ## COMMANDS
        The following commands are available. Use \`--help\` on a command for
        more detail.
        > commands
    EOF
}

function :args {
    eval "$(args -UD -bx h,help -- "$@")"
}

function :help:version {
    heredoc -v help -q <<'    EOF'
        # desc -- display version
        Display the current Barnyard version.
        # opt help
        Display help for \`barnyard version\`.
        # man
        ## DESCRIPTION
        \`barnyard version\` prints the Barnyard version number to standard out.
        ## OPTIONS
        > options
    EOF
}

function :args:version {
    eval "$(args -bx h,help -- "$@")"
}

function :execute:version {
    print $BARNYARD_VERSION
}


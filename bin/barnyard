}

function :help:agent:prepare:ubuntu {
    heredoc -v help -q <<'    EOF'
        # desc -- prepare the local Ubuntu agent
        Prepare the local Ubuntu machine for Barnyard.
        # opt help
        Display help for \`barnyard agent prepare ubuntu\`.
        # man
        ## DESCRIPTION
        \`barnyard agent prepare ubuntu\` runs on the Ubuntu machine itself. It
        verifies the installed tools, creates \`/etc/barnyard\`, creates the
        machine age key if one does not already exist, records the public age
        key for commit back to the control side, and prepares the Barnyard GPG
        home and machine key.
        ## OPTIONS
        > options
        ## SEE ALSO
        \`barnyard agent\` for the machine side of Barnyard.

        \`barnyard control prepare ubuntu\` for the operator command that invokes
        this command during bootstrap.
    EOF
}

function :args:agent:prepare:ubuntu {
    eval "$(args -bx h,help -- "$@")"
}

function :execute:agent:prepare:ubuntu {
    exemplar :barnyard:prepare:ubuntu
}

function :barnyard:prepare:ubuntu {
    setopt localoptions pipefail
    typeset tmp; tmp=$(mktemp -d)
    {
        pushd $tmp
        block 'git'
        {
            (){ git --version }
        } always {
            caught
        } > >(indent)
        block 'age'
        {
            (){ mkdir -p /etc/barnyard }
            (){ age --version }
            (){ age-keygen --version }
            (){
                [[ -e /etc/barnyard/age ]] || age-keygen -o /etc/barnyard/age
            }
            (){ mkdir -p /var/lib/barnyard/commit/age }
            (){
                % $(</etc/hostname)
                age-keygen -y /etc/barnyard/age |
                    tee /var/lib/barnyard/commit/age/%q
            }
        } always {
            caught
        } > >(indent)
        block 'gpg'
        {
            (){ gpg --version }
            (){ export GNUPGHOME=/etc/barnyard/gnupg }
            (){ print $GNUPGHOME }
            (){ ( umask 077 && mkdir -p /etc/barnyard/gnupg ) }
            (){
                { cat > key_details; }
            } % $(</etc/hostname) $(</etc/hostname) <<'            EOF'
                %%echo Generating a basic OpenPGP key
                Key-Type: RSA
                Key-Length: 2048
                Subkey-Type: RSA
                Subkey-Length: 2048
                Name-Real: %s
                Name-Comment: Root Personal Key
                Name-Email: user@%s
                Expire-Date: 0
                %%no-ask-passphrase
                %%no-protection
                # Do a commit here, so that we can later print "done" :-)
                %%commit
                %%echo done
            EOF
            (){
                % $(</etc/hostname)
                gpg --list-keys %q || gpg --verbose --batch --gen-key key_details
            }
            (){ gpg --list-keys }
        } always {
            caught
        } > >(indent)
    } always {
        popd
        [[ -d $tmp ]] && rm -rf $tmp
    }
}

# We could transfer this age encrypted, but we assume it is coming from
# `barnyard control` over SSH or from a file on the filesystem of the operator
# machine.

function :args:ssh:known-hosts {
    eval "$(args v,version f,file -bx h,help -- "$@")"
}

function :execute:ssh:known-hosts {
    barnyard_version_check
    [[ -v o_file ]] || abend 'a "known_hosts" file is required'
    exemplar :barnyard:ssh:known-hosts
}

function :barnyard:ssh:known-hosts {
    typeset known_hosts
    block 'set SSH known hosts'
    {
        (){ (( $EUID == 0 )) }
        if [[ $o_file = - ]]; then
            show eval 'known_hosts=$(cat)'
        else
            (){ % $o_file; [[ -e %q ]] }
            (){ % $o_file; known_hosts=$(<%q) }
        fi
        (){ printf '%s\n' $known_hosts > /etc/barnyard/known_hosts }
        (){ cat /etc/barnyard/known_hosts }
    } always {
        caught
    } > >(indent)
}

function :args:ssh:private-key {
    eval "$(args v,version f,file -bx h,help -- "$@")"
}

function :execute:ssh:private-key {
    barnyard_version_check
    [[ -v o_file ]] || abend 'key file is required'
    exemplar :barnyard:ssh:private-key
}

function :barnyard:ssh:private-key {
    typeset key
    block 'set private SSH key'
    {
        (){ (( $EUID == 0 )) }
        if [[ $o_file = - ]]; then
            try show eval 'key=$(cat)' || tried
        else
            (){ % $o_file; [[ -e %q ]] }
            (){ % $o_file; key=$(<%q) }
        fi
        (){ rm -f /etc/barnyard/id_barnyard }
        (){ wc <<< $key }
        (){ (umask 077 && print -- $key > /etc/barnyard/id_barnyard) }
        (){ ssh-keygen -lf /etc/barnyard/id_barnyard }
    } always {
        caught
    } > >(indent)
}

function :args:ssh {
    eval "$(args -bx h,help -- "$@")"
}

function :execute:ssh {
    delegate "$@"
}

function :args:module {
    eval "$(args -s ,barnyard -s ,module -- "$@")"
}

function :execute:module {
    function {
        typeset o_check_signature=0
        typeset -A o_barnyard=( "${(@QA)${(z)1}}" )
        typeset -A o_module=( "${(@QA)${(z)2}}" )
        shift 2
        cd "$o_barnyard[archive]"
        typeset -A o_block
        source "$o_barnyard[source]"
        exit
    } $o_barnyard $o_module
}

